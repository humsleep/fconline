# FC Scope — 환경변수 예시 (.env.local 로 복사해서 값 채우기)
# NEXT_PUBLIC_* 는 브라우저에 노출됨(공개 값만). 나머지는 서버 전용 비밀.

# ── 배포 도메인 ──────────────────────────────────────────────
# 운영 도메인. 미설정 시 코드 기본값(https://www.fcscope.xyz) 사용.
# sitemap / robots / canonical / OG 이미지 URL 이 모두 이 값에서 파생됨.
NEXT_PUBLIC_SITE_URL=https://www.fcscope.xyz

# ── 검색엔진 소유확인 (메타태그 방식) ────────────────────────
# 값 넣으면 <head> 에 verification meta 자동 출력. 비우면 미출력(=DNS 방식 사용 가능).
# Google Search Console → HTML 태그 방식의 content 값만 붙여넣기
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 → HTML 태그 방식의 content 값만 붙여넣기
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# ── Supabase (인증 + DB) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — RLS 우회 권한. 클라이언트에 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ── 외부 API ─────────────────────────────────────────────────
NEXON_API_KEY=

# ── 기타 ─────────────────────────────────────────────────────
# 관리자 이메일(콤마 구분)
ADMIN_EMAILS=
# 비로그인 사용량 IP 해시 솔트(32자 이상 권장)
IP_HASH_SALT=
# Vercel Cron 인증 시크릿
CRON_SECRET=
# 데모/샘플 노출용 닉네임 — 웹 '예시 리포트' 버튼 + iOS 앱 홈 '예시 리포트' 카드
NEXT_PUBLIC_DEMO_NICKNAME=보엠

# ── iOS 앱 연동 (앱 소스는 별도 저장소) ───────────────────────
# AdMob 게시자 ID(pub-…) — /app-ads.txt 노출용
ADMOB_PUBLISHER_ID=
# Apple Developer 팀 ID — /.well-known/apple-app-site-association (유니버설 링크) 노출용
APPLE_TEAM_ID=
# Sign in with Apple 토큰 폐기(계정 삭제 시, App Store 5.1.1(v)) — Keys 에서 "Sign in with Apple" 을 체크해 만든 키(.p8)
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
# iOS 번들 ID (기본 xyz.fcscope.app) — /.well-known/apple-app-site-association appID
NEXT_PUBLIC_IOS_BUNDLE_ID=xyz.fcscope.app

# ── iOS 푸시 (APNs 토큰 인증, Apple Developer > Keys > APNs .p8) ──
APNS_KEY_ID=
APNS_TEAM_ID=
# .p8 파일 내용 전체(개행은 \n 으로 이스케이프 가능)
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=xyz.fcscope.app
# 개발(TestFlight 아님, Xcode 직접 설치) 빌드에 보낼 땐 1
APNS_SANDBOX=
