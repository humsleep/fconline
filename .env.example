# FC Scope — 환경변수 예시 (.env.local 로 복사해서 값 채우기)
# NEXT_PUBLIC_* 는 브라우저에 노출됨(공개 값만). 나머지는 서버 전용 비밀.

# ── 배포 도메인 ──────────────────────────────────────────────
# 운영 도메인. 미설정 시 코드 기본값(https://www.fcscope.xyz) 사용.
# sitemap / robots / canonical / OG 이미지 URL 이 모두 이 값에서 파생됨.
NEXT_PUBLIC_SITE_URL=https://www.fcscope.xyz

# ── 검색엔진 소유확인 (메타태그 방식) ────────────────────────
# 값 넣으면 <head> 에 verification meta 자동 출력. 비우면 미출력(=DNS 방식 사용 가능).
# Google Search Console → HTML 태그 방식의 content 값만 붙여넣기
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 → HTML 태그 방식의 content 값만 붙여넣기
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# ── Supabase (인증 + DB) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — RLS 우회 권한. 클라이언트에 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ── 외부 API ─────────────────────────────────────────────────
NEXON_API_KEY=

# ── 기타 ─────────────────────────────────────────────────────
# 관리자 이메일(콤마 구분)
ADMIN_EMAILS=
# 비로그인 사용량 IP 해시 솔트(32자 이상 권장)
IP_HASH_SALT=
# Vercel Cron 인증 시크릿
CRON_SECRET=
# 데모/샘플 노출용 닉네임(선택)
NEXT_PUBLIC_DEMO_NICKNAME=
